apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ workload.name }}
  namespace: {{ workload.namespace }}
  labels:
    app.kubernetes.io/name: {{ workload.name }}
    release: sog-observability
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ workload.name }}
  endpoints:
    - port: http
      path: /metrics/
      interval: 30s
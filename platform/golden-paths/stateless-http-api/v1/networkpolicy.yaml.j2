apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ workload.name }}-default-deny
  namespace: {{ workload.namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: {{ workload.name }}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ workload.name }}-allow-dns
  namespace: {{ workload.namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: {{ workload.name }}
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ workload.name }}-allow-prometheus
  namespace: {{ workload.namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: {{ workload.name }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: sog-nonprod-observability
          podSelector:
            matchLabels:
              app.kubernetes.io/name: prometheus
      ports:
        - protocol: TCP
          port: {{ workload.port }}
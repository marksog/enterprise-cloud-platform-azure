apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ workload.name }}
  namespace: {{ workload.namespace }}
  labels:
    app.kubernetes.io/name: {{ workload.name }}
    app.kubernetes.io/managed-by: sog-platform
spec:
  replicas: {{ profile.replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ workload.name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ workload.name }}
        app.kubernetes.io/managed-by: sog-platform
    spec:
      serviceAccountName: {{ workload.name }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: {{ workload.name }}
          image: {{ workload.image }}
          ports:
            - name: http
              containerPort: {{ workload.port }}
          resources:
            requests:
              cpu: {{ profile.cpu_request }}
              memory: {{ profile.memory_request }}
            limits:
              cpu: {{ profile.cpu_limit }}
              memory: {{ profile.memory_limit }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL